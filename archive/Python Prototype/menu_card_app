# ---------- Drawing helpers ----------
def rounded_rect(w, h, r, fill=None, outline=None, width=1):
    img = Image.new("RGBA", (max(1,int(round(w))), max(1,int(round(h)))), (0,0,0,0))
    ImageDraw.Draw(img).rounded_rectangle([0,0,img.width-1,img.height-1], r,
                                          fill=fill, outline=outline, width=max(1,int(round(width))))
    return img

def add_img(canvas, pil_img, x, y, w=None, h=None):
    if w is not None and h is not None:
        pil_img = pil_img.resize((max(1,int(round(w))), max(1,int(round(h)))), Image.LANCZOS)
    tk_img = _keep(ImageTk.PhotoImage(pil_img))
    canvas.create_image(x, y, anchor="nw", image=tk_img)

def draw_text(canvas, text, x, y, w, h, font_path, px, color="black", anchor="nw"):
    img = Image.new("RGBA", (max(1,int(round(w))), max(1,int(round(h)))), (0,0,0,0))
    d = ImageDraw.Draw(img)
    try: fnt = ImageFont.truetype(font_path, max(1,int(round(px))))
    except: fnt = ImageFont.load_default()
    bbox = d.textbbox((0,0), text, font=fnt)
    tw, th = bbox[2]-bbox[0], bbox[3]-bbox[1]
    if anchor in ("center","c"):
        pos = ((img.width - tw) / 2, (img.height - th) / 2)
    else:
        pos = (0,0)
    d.text(pos, text, font=fnt, fill=color)
    add_img(canvas, img, x, y)

def stacked_outline(canvas, x, y, w, h, colors, fill=None, radius=10, width_each=2):
    pad = len(colors)*width_each + 2
    img = Image.new("RGBA", (int(round(w+2*pad)), int(round(h+2*pad))), (0,0,0,0))
    d = ImageDraw.Draw(img)
    for i, col in enumerate(colors):
        inset = i*width_each
        d.rounded_rectangle([pad+inset, pad+inset, pad+w-inset-1, pad+h-inset-1],
                            radius=max(2, radius - i),
                            outline=col, width=width_each,
                            fill=fill if i == len(colors)-1 else None)
    add_img(canvas, img, x-pad, y-pad)

def draw_centered_icon_on(layer_img, icon_key, scale_target):
    """Draw icon centered on a given PIL image layer."""
    fn = ICON.get(icon_key)
    if not fn: return layer_img
    p = os.path.join(ICONS_DIR, fn)
    if not os.path.exists(p): return layer_img
    ic = Image.open(p).convert("RGBA")
    tgt = int(scale_target)
    ic = ic.resize((max(1,tgt), max(1,tgt)), Image.LANCZOS)
    lx = (layer_img.width - tgt) // 2
    ly = (layer_img.height - tgt) // 2
    layer_img.alpha_composite(ic, (lx, ly))
    return layer_img

def circle_button(canvas, x, y, d_base, fill_hex, outline_hex, icon_key, sx, sy):
    """
    Perfect circle regardless of non-uniform scaling:
    - Nominal rect: (S(x), T(y)) with size S(d_base) by T(d_base)
    - Actual circle diameter = min(S(d_base), T(d_base))
    - Circle is centered within the nominal rect.
    """
    nominal_w = sx * d_base
    nominal_h = sy * d_base
    size = min(nominal_w, nominal_h)                 # enforce circle
    left = sx * x + (nominal_w - size) / 2
    top  = sy * y + (nominal_h - size) / 2

    border_w = max(1, int(round(size * 0.02)))       # proportional outline
    base = rounded_rect(size, size, size/2, fill=fill_hex, outline=outline_hex, width=border_w)
    base = draw_centered_icon_on(base, icon_key, size * 0.62)
    add_img(canvas, base, left, top)

def pill_button_bg(canvas, x, y, w_base, h_base, fillc, outc, sx, sy):
    """
    Proper pill (semicircular ends) under non-uniform scaling:
    - Width = S(w_base), Height = T(h_base)
    - Corner radius = height/2 to keep semicircles.
    """
    W = sx * w_base
    H = sy * h_base
    r = H / 2.0
    add_img(canvas, rounded_rect(W, H, r, fill=fillc, outline=outc, width=max(1,int(round(2*sy)))), sx*x, sy*y)

def place_icon_on_button(canvas, x_canvas, y_canvas, w_canvas, h_canvas, icon_key, desired_center_x_canvas):
    """Place icon centered at a fixed canvas X within a button rect (canvas units)."""
    fn = ICON.get(icon_key)
    if not fn: return
    p = os.path.join(ICONS_DIR, fn)
    if not os.path.exists(p): return
    ic = Image.open(p).convert("RGBA")
    tgt = int(min(w_canvas, h_canvas) * 0.62)
    ic = ic.resize((max(1,tgt), max(1,tgt)), Image.LANCZOS)

    layer = Image.new("RGBA", (max(1,int(round(w_canvas))), max(1,int(round(h_canvas)))), (0,0,0,0))
    lx = int(round(desired_center_x_canvas - x_canvas - tgt / 2))
    ly = int(round(layer.height / 2 - tgt / 2))
    layer.alpha_composite(ic, (lx, ly))
    add_img(canvas, layer, x_canvas, y_canvas)

