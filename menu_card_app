# ------------------------------- Drawing Code --------------------------------
_cache = {
    "title_img": None,
    "version_img": None,
    "page_img": None,
    "page_item": None,
}
_header_pts = {"title": None, "version": None}

def render_text_image(text, font_path, pt_size, fill=FG_COLOR):
    try:
        font = ImageFont.truetype(font_path, pt_size)
    except Exception:
        # Fallback to default if font file missing
        try:
            font = ImageFont.truetype("Segoe UI", pt_size)
        except Exception:
            font = ImageFont.load_default()

    bbox = font.getbbox(text)
    w, h = bbox[2] - bbox[0], bbox[3] - bbox[1]
    pad = max(1, pt_size // 6)
    img = Image.new("RGBA", (w + 2 * pad, h + 2 * pad), (0, 0, 0, 0))
    ImageDraw.Draw(img).text((pad - bbox[0], pad - bbox[1]), text, font=font, fill=fill)
    return ImageTk.PhotoImage(img)

def draw_header():
    header_canvas.delete("all")
    left_w = max(1, left_container.winfo_width())
    h = max(1, int(root.winfo_height() * 0.16))
    header_canvas.config(width=left_w, height=h)

    s = min(root.winfo_width() / REF_W, root.winfo_height() / REF_H)
    title_pt   = clamp(int(round(REF_TITLE_PT   * s)), 18, 160)
    version_pt = clamp(int(round(REF_VERSION_PT * s)), 10,  96)

    if _header_pts["title"] != title_pt:
        _cache["title_img"] = render_text_image(TITLE, KIEVIT_TTF, title_pt)
        _header_pts["title"] = title_pt
    if _header_pts["version"] != version_pt:
        _cache["version_img"] = render_text_image(VERSION, MINION_TTF, version_pt)
        _header_pts["version"] = version_pt

    x0, y0 = LEFT_PAD_X, TOP_PAD_Y
    if _cache["title_img"]:
        header_canvas.create_image(x0, y0, anchor="nw", image=_cache["title_img"])
        th = _cache["title_img"].height()
    else:
        th = 0
    if _cache["version_img"]:
        header_canvas.create_image(x0, y0 + th + LINE_SPACING, anchor="nw", image=_cache["version_img"])

def rounded_left_panel(cv: tk.Canvas, color: str, radius: int):
    """Draw a panel rounded on the left side only."""
    cv.delete("panel")
    w, h = max(1, cv.winfo_width()), max(1, cv.winfo_height())
    r = clamp(radius, 0, min(w, h) // 2)
    # rectangles + arcs
    cv.create_rectangle(r, 0, w, h, fill=color, outline=color, tags="panel")
    cv.create_rectangle(0, r, w, h - r, fill=color, outline=color, tags="panel")
    cv.create_arc(0, 0, 2*r, 2*r, start=90, extent=90, fill=color, outline=color, tags="panel")
    cv.create_arc(0, h - 2*r, 2*r, h, start=180, extent=90, fill=color, outline=color, tags="panel")
    cv.tag_lower("panel")

def make_page_texture(w, h, base0="#000000", base1="#182b49"):
    img = Image.new("RGB", (w, h), hex_to_rgb(base0))
    px = img.load()
    c0, c1 = hex_to_rgb(base0), hex_to_rgb(base1)

    # soft diagonal gradient
    for y in range(h):
        fy = y / (h - 1 if h > 1 else 1)
        for x in range(w):
            fx = x / (w - 1 if w > 1 else 1)
            t = (fx + fy) * 0.5
            col = lerp_color(c0, c1, t * 2) if t <= 0.5 else lerp_color(c1, c0, (t - 0.5) * 2)
            px[x, y] = col

    # vignette “bloom” near top-right to match screenshot
    cx, cy, r = int(w * 0.85), int(h * 0.18), int(min(w, h) * 1.2)
    for y in range(h):
        for x in range(w):
            d = math.hypot(x - cx, y - cy)
            t = clamp(d / r, 0.0, 1.0)
            boost = int((1 - t) ** 2 * 28)
            R, G, B = px[x, y]
            px[x, y] = (clamp(R + boost, 0, 255),
                        clamp(G + boost, 0, 255),
                        clamp(B + boost, 0, 255))
    return img

_tex_cache = {"base": None, "size": 1024}
def get_page_texture(w, h):
    if _tex_cache["base"] is None:
        _tex_cache["base"] = make_page_texture(_tex_cache["size"], _tex_cache["size"])
    return _tex_cache["base"].resize((max(1, w), max(1, h)), Image.LANCZOS)

def draw_static_page():
    rounded_left_panel(right_panel_canvas, PANEL_COLOR, CORNER_RADIUS)

    w, h = max(1, right_panel_canvas.winfo_width()), max(1, right_panel_canvas.winfo_height())
    vw, vh = max(1, w - 2 * PANEL_INNER_PAD), max(1, h - 2 * PANEL_INNER_PAD)

    fit_w, fit_h = int(vw * PAGE_FIT_FACTOR), int(vh * PAGE_FIT_FACTOR)
    cand_w = fit_w - 2 * PAGE_BORDER
    cand_h = int(cand_w * PAGE_ASPECT)
    if cand_h + 2 * PAGE_BORDER > fit_h:
        cand_h = fit_h - 2 * PAGE_BORDER
        cand_w = int(cand_h / PAGE_ASPECT)

    full_w, full_h = cand_w + 2 * PAGE_BORDER, cand_h + 2 * PAGE_BORDER
    frame_img = Image.new("RGB", (full_w, full_h), hex_to_rgb(PANEL_COLOR))
    frame_img.paste(get_page_texture(cand_w, cand_h), (PAGE_BORDER, PAGE_BORDER))
    ph = ImageTk.PhotoImage(frame_img)
    _cache["page_img"] = ph

    x0, y0 = (w - full_w) // 2, (h - full_h) // 2
    if _cache["page_item"] is None:
        _cache["page_item"] = right_panel_canvas.create_image(x0, y0, anchor="nw", image=ph, tags=("pageimg",))
    else:
        right_panel_canvas.coords(_cache["page_item"], x0, y0)
        right_panel_canvas.itemconfig(_cache["page_item"], image=ph)

    right_panel_canvas.tag_raise("pageimg")
    right_panel_canvas.tag_lower("panel")

# ---- Shapes on left: circles & pills ----------------------------------------
def draw_allergen_circles():
    # Lay out 11 circles in 3 columns (3-3-3-2)
    left_w = left_grp.winfo_width()
    if left_w < 10:
        root.after(50, draw_allergen_circles)
        return

    # Use ~92% of left group width to leave breathing room
    avail_w = int(left_w * 0.92)
    gap = clamp(int(avail_w * 0.03), 12, 34)
    cols = ALLERGEN_COLS
    diameter = (avail_w - (cols - 1) * gap) // cols
    diameter = clamp(diameter, 52, 160)
    outline = clamp(int(diameter * 0.06), 4, 8)

    rows = (ALLERGEN_COUNT + cols - 1) // cols
    canvas_w = cols * diameter + (cols - 1) * gap
    canvas_h = rows * diameter + (rows - 1) * gap
    allergen_canvas.config(width=canvas_w, height=canvas_h)

    allergen_canvas.delete("allergen")
    fill_color, outline_color = "#000000", "#ff0000"
    for i in range(ALLERGEN_COUNT):
        r = i // cols
        c = i % cols
        x0 = c * (diameter + gap)
        y0 = r * (diameter + gap)
        pad = outline / 2
        allergen_canvas.create_oval(
            x0 + pad, y0 + pad, x0 + diameter - pad, y0 + diameter - pad,
            fill=fill_color, outline=outline_color, width=outline,
            tags=("allergen", f"idx{i}")
        )

def draw_attribute_row():
    # 3 circles in a row (right group top)
    rw = right_grp.winfo_width()
    if rw < 10:
        root.after(50, draw_attribute_row)
        return

    # Use ~85% of right width for the row
    avail_w = int(rw * 0.85)
    gap = clamp(int(avail_w * 0.06), 16, 36)
    cols = 3
    diameter = (avail_w - (cols - 1) * gap) // cols
    diameter = clamp(diameter, 46, 120)
    outline = clamp(int(diameter * 0.06), 4, 8)

    canvas_w = cols * diameter + (cols - 1) * gap
    canvas_h = diameter
    attr_canvas.config(width=canvas_w, height=canvas_h)

    attr_canvas.delete("attr")
    for c in range(cols):
        x0 = c * (diameter + gap)
        pad = outline / 2
        attr_canvas.create_oval(
            x0 + pad, pad, x0 + diameter - pad, canvas_h - pad,
            fill="#000000", outline="#ff0000", width=outline, tags="attr"
        )

def rounded_rect(canvas, x0, y0, x1, y1, r, **kw):
    """Draw a rounded rectangle (full)."""
    r = max(0, min(r, (x1 - x0) / 2, (y1 - y0) / 2))
    canvas.create_rectangle(x0 + r, y0, x1 - r, y1, **kw)
    canvas.create_rectangle(x0, y0 + r, x1, y1 - r, **kw)
    canvas.create_arc(x0, y0, x0 + 2*r, y0 + 2*r, start=90, extent=90, **kw)
    canvas.create_arc(x1 - 2*r, y0, x1, y0 + 2*r, start=0, extent=90, **kw)
    canvas.create_arc(x0, y1 - 2*r, x0 + 2*r, y1, start=180, extent=90, **kw)
    canvas.create_arc(x1 - 2*r, y1 - 2*r, x1, y1, start=270, extent=90, **kw)

def draw_pill_list(canvas, target_width, n_rows=5):
    if target_width < 10:
        return
    canvas.delete("pill")

    # Pill width ~ 78% of right column; height ~ 18% of its width; clamp
    pw = int(target_width * 0.78)
    ph = clamp(int(pw * 0.18), 26, 44)
    gap = clamp(int(ph * 0.6), 10, 22)
    outline = clamp(int(ph * 0.18), 3, 6)
    radius = ph // 2

    cw = pw
    ch = n_rows * ph + (n_rows - 1) * gap
    canvas.config(width=cw, height=ch)

    for i in range(n_rows):
        y0 = i * (ph + gap)
        rounded_rect(canvas, 0 + outline/2, y0 + outline/2,
                     pw - outline/2, y0 + ph - outline/2,
                     radius,
                     fill="#000000", outline="#ff0000", width=outline, tags="pill")

def draw_pills():
    rw = right_grp.winfo_width()
    if rw < 10:
        root.after(50, draw_pills)
        return
    draw_pill_list(colors_canvas, rw)
    draw_pill_list(tex_canvas, rw)

# ------------------------------ Resize Handling ------------------------------
_last_root_size = (None, None)
_resize_job = None

def schedule_redraw():
    global _resize_job
    if _resize_job is not None:
        root.after_cancel(_resize_job)
    _resize_job = root.after(80, redraw_everything)

def on_root_configure(evt):
    if evt.widget is root:
        w, h = evt.width, evt.height
        global _last_root_size
        if _last_root_size != (w, h):
            _last_root_size = (w, h)
            schedule_redraw()

def redraw_everything():
    # scale label font
    s = min(root.winfo_width() / REF_W, root.winfo_height() / REF_H)
    new_label = clamp(int(round(REF_LABEL_PT * s)), 10, 36)
    if label_font.cget("size") != new_label:
        label_font.configure(size=new_label)

    # refresh header and right panel
    draw_header()
    draw_static_page()

    # left shapes
    draw_allergen_circles()
    draw_attribute_row()
    draw_pills()

# ------------------------------- Kick Things Off -----------------------------
root.bind("<Configure>", on_root_configure)
schedule_redraw()
root.mainloop()
