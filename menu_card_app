    # ------------- Text layout helpers -------------
    def _wrap(self, draw, text, font, max_w):
        if not text: return [], 0, 0
        words = text.split(); lines=[]; cur=""
        for w in words:
            t = (cur+" "+w).strip()
            wbox = draw.textbbox((0,0), t, font=font)
            if wbox[2]-wbox[0] <= max_w or not cur: cur=t
            else: lines.append(cur); cur=w
        if cur: lines.append(cur)
        lh = draw.textbbox((0,0),"Ag",font=font)[3]
        return lines, lh, max(draw.textbbox((0,0),ln,font=font)[2] for ln in lines)

    # ------------- Rendering -------------
    def _rects(self):
        rects=[]
        for r in range(ROWS):
            for c in range(COLS):
                x0 = START_X + c*(CARD_W + GAP_X)
                y0 = START_Y + r*(CARD_H + GAP_Y)
                rects.append((x0,y0,x0+CARD_W,y0+CARD_H))
        return rects

    def _draw_legibility_radial(self, base_img, center_xy, radius, opacity=200):
        size = radius*2
        grad = Image.new("L", (size,size), 0)
        px = grad.load()
        for y in range(size):
            for x in range(size):
                dx = x-radius; dy=y-radius
                t = max(0.0, min(1.0, 1.0-((dx*dx+dy*dy)**0.5)/radius))
                px[x,y] = int(t*opacity)
        white = Image.new("RGBA", (size,size), (255,255,255,0))
        white.putalpha(grad)
        base_img.alpha_composite(white, (center_xy[0]-radius, center_xy[1]-radius))

    def _fit_block(self, draw, card, box, gap_px):
        x0,y0,x1,y1 = box
        W,H = x1-x0, y1-y0
        f_title = load_font(FONT_KIEVIT, self.item_pt.get())
        f_all   = load_font(FONT_BEBAS,  self.all_pt.get())
        f_cont  = load_font(FONT_BEBAS,  self.contains_pt.get())

        # Compose lines
        t_lines, t_lh, t_bw = self._wrap(draw, card.title, f_title, W)
        a_text = card.allergens_line
        c_text = card.contains_line
        a_lines, a_lh, a_bw = self._wrap(draw, a_text, f_all, W) if a_text else ([],0,0)
        c_lines, c_lh, c_bw = self._wrap(draw, c_text, f_cont, W) if c_text else ([],0,0)

        # Compute total height
        total = t_lh*len(t_lines)
        if a_lines: total += gap_px + a_lh*len(a_lines)
        if c_lines: total += gap_px + c_lh*len(c_lines)

        # Simple shrink loop
        t_pt = self.item_pt.get(); a_pt = self.all_pt.get(); c_pt = self.contains_pt.get()
        while total > H:
            # shrink the biggest
            if t_pt >= a_pt and t_pt >= c_pt and t_pt > 18:
                t_pt -= 2; f_title = load_font(FONT_KIEVIT, t_pt)
            elif a_pt >= c_pt and a_pt > 12 and a_lines:
                a_pt -= 2; f_all = load_font(FONT_BEBAS, a_pt)
            elif c_pt > 12 and c_lines:
                c_pt -= 2; f_cont = load_font(FONT_BEBAS, c_pt)
            else:
                break
            t_lines, t_lh, t_bw = self._wrap(draw, card.title, f_title, W)
            a_lines, a_lh, a_bw = (self._wrap(draw, a_text, f_all, W) if a_text else ([],0,0))
            c_lines, c_lh, c_bw = (self._wrap(draw, c_text, f_cont, W) if c_text else ([],0,0))
            total = t_lh*len(t_lines) + (gap_px + a_lh*len(a_lines) if a_lines else 0) + \
                    (gap_px + c_lh*len(c_lines) if c_lines else 0)

        # Center vertically
        y = y0 + (H-total)//2
        cx = x0 + W//2

        for ln in t_lines:
            w = draw.textbbox((0,0), ln, font=f_title)[2]
            draw.text((cx - w//2, y), ln, font=f_title, fill=BLACK); y += t_lh
        if a_lines:
            y += gap_px
            for ln in a_lines:
                w = draw.textbbox((0,0), ln, font=f_all)[2]
                draw.text((cx - w//2, y), ln, font=f_all, fill=(200,0,0)); y += a_lh
        if c_lines:
            y += gap_px
            for ln in c_lines:
                w = draw.textbbox((0,0), ln, font=f_cont)[2]
                draw.text((cx - w//2, y), ln, font=f_cont, fill=DARK_GREY); y += c_lh

    def _page_image(self, page_idx, export=False, highlight=None):
        if export:
            base = Image.new("RGB", (PAGE_W, PAGE_H), (255,255,255)).convert("RGBA")
        else:
            base = preview_gradient(PAGE_W, PAGE_H).convert("RGBA")

        draw = ImageDraw.Draw(base)
        pad = int(0.18*INCH)
        gap_px = int(self.gap_pt.get()/72.0 * EXPORT_DPI)
        rects = self._rects()
        start = page_idx*SLOTS_PER_PAGE
        for slot,(x0,y0,x1,y1) in enumerate(rects):
            draw.rectangle([x0,y0,x1,y1], fill=CARD_BG)
            idx = start+slot
            if idx < len(self.cards):
                card = self.cards[idx]
                self._fit_block(draw, card, (x0+pad,y0+pad,x1-pad,y1-pad), gap_px)

                # top-right attribute badge (with legibility halo)
                badge = int(0.36*INCH); margin = int(0.12*INCH)
                bx, by = x1 - margin - badge, y0 + margin
                self._draw_legibility_radial(base, (bx+badge//2, by+badge//2), radius=badge//2)
                icon = None
                if card.cc_all:
                    cc = Image.new("RGBA",(badge,badge),(0,0,0,0))
                    d = ImageDraw.Draw(cc)
                    d.ellipse([0,0,badge-1,badge-1], fill=(255,255,255,235), outline=(0,0,0,255), width=3)
                    f = load_font(FONT_BEBAS, int(badge*0.48))
                    tw = d.textbbox((0,0),"CC", font=f)[2]
                    d.text(((badge - tw)//2, int(badge*0.26)), "CC", font=f, fill=(0,0,0,255))
                    icon = cc
                elif "Vegan" in card.attributes and os.path.isfile(ICON_VEGAN):
                    icon = load_icon(ICON_VEGAN, badge)
                elif "Halal" in card.attributes and os.path.isfile(ICON_HALAL):
                    icon = load_icon(ICON_HALAL, badge)
                if icon:
                    base.alpha_composite(icon, (bx,by))

        # selection highlight
        if not export and highlight is not None:
            if start <= highlight < start+SLOTS_PER_PAGE:
                slot = highlight - start
                sx0,sy0,sx1,sy1 = rects[slot]
                draw.rectangle([sx0+6,sy0+6,sx1-6,sy1-6], outline=(50,120,220,255), width=6)

        return base.convert("RGB" if export else "RGBA")

    def _render_all_previews(self):
        self.canvas.delete("all")
        self.page_img_tk.clear(); self.page_offsets.clear()
        total_pages = max(1, math.ceil(len(self.cards)/SLOTS_PER_PAGE))
        y = 20
        gap = int(40 * PREVIEW_SCALE)
        for p in range(total_pages):
            page = self._page_image(p, export=False, highlight=self.sel_global_idx)
            scaled = page.resize((int(PAGE_W*PREVIEW_SCALE), int(PAGE_H*PREVIEW_SCALE)), Image.LANCZOS)
            tkimg = ImageTk.PhotoImage(scaled)
            self.page_img_tk.append(tkimg)
            self.page_offsets.append(y)
            self.canvas.create_image(20, y, anchor="nw", image=tkimg)
            y += scaled.height + gap

        self.canvas.config(scrollregion=(0,0,int(PAGE_W*PREVIEW_SCALE)+40,y))
        self.count_lbl.config(text=f"{len(self.cards)} cards total")

        # top legibility band #e5e5e5 -> transparent
        band_h = 60
        grad = Image.new("RGBA", (int(PAGE_W*PREVIEW_SCALE)+60, band_h), (229,229,229,0))
        px = grad.load()
        for yy in range(band_h):
            a = int(255*(1-yy/band_h))
            for xx in range(grad.size[0]):
                px[xx,yy] = (229,229,229,a)
        tkgrad = ImageTk.PhotoImage(grad)
        self.page_img_tk.append(tkgrad)
        self.canvas.create_image(0, 0, anchor="nw", image=tkgrad)

    # ------------- Preview events -------------
    def _page_from_y(self, y_scaled):
        for i, top in enumerate(self.page_offsets):
            h = int(PAGE_H*PREVIEW_SCALE)
            if top <= y_scaled < top+h: return i, top
        if self.page_offsets:
            d = [(abs(y_scaled-top), i) for i,top in enumerate(self.page_offsets)]
            i = min(d)[1]; return i, self.page_offsets[i]
        return 0,0

    def _on_click_preview(self, e):
        x_view = self.canvas.canvasx(e.x); y_view = self.canvas.canvasy(e.y)
        page_idx, page_top = self._page_from_y(int(y_view))
        x_full = int((x_view - 20) / PREVIEW_SCALE)   # account for left pad
        y_full_on_page = int((y_view - page_top) / PREVIEW_SCALE)
        rects = self._rects()
        slot=None
        for s,(x0,y0,x1,y1) in enumerate(rects):
            if x0 <= x_full <= x1 and y0 <= y_full_on_page <= y1: slot=s; break
        if slot is not None:
            idx = page_idx*SLOTS_PER_PAGE + slot
            if idx < len(self.cards):
                self.sel_global_idx = idx; self._render_all_previews(); return
        self.sel_global_idx=None; self._render_all_previews()

    def _on_mousewheel(self, e):
        UNITS_WIN=6; UNITS_MAC=25; UNITS_LIN=6
        if hasattr(e,"num") and e.num in (4,5):
            direction = -1 if e.num==4 else 1; self.canvas.yview_scroll(direction*UNITS_LIN,"units"); return
        delta=int(getattr(e,"delta",0)); 
        if delta==0: return
        steps = (-int(delta/120)*UNITS_WIN) if os.name=="nt" else ((-1 if delta>0 else 1)*UNITS_MAC)
        self.canvas.yview_scroll(steps, "units")

    # ------------- Actions -------------
    def _add_card(self):
        title = self.item_var.get().strip()
        if not title:
            messagebox.showwarning("Missing", "Enter an item name."); return
        allergens = [a for a,v in self.all_vars.items() if v.get()]
        attrs = set()
        if self.attr_vegan.get(): attrs.add("Vegan")
        if self.attr_halal.get(): attrs.add("Halal")
        artificial = [k for k,v in self.art_vars.items() if v.get()]
        textures = [k for k,v in self.tex_vars.items() if v.get()]
        card = MenuCard(title, allergens, cc_all=self.cc_var.get(),
                        attributes=attrs, artificial_colors=artificial, textures=textures)
        self.cards.append(card)

        # reset inputs for fast entry
        self.item_var.set("")
        for d in (self.all_vars, self.art_vars, self.tex_vars): 
            for v in d.values(): v.set(False)
        self.attr_vegan.set(False); self.attr_halal.set(False)
        # leave CC as-is intentionally

        self.sel_global_idx=None
        self._render_all_previews()

    def _clear_all(self):
        if not self.cards: return
        if messagebox.askyesno("Clear all", "Remove all cards from all pages?"):
            self.cards.clear(); self.sel_global_idx=None; self._render_all_previews()

    def _delete_selected(self, _e=None):
        if self.sel_global_idx is not None and 0 <= self.sel_global_idx < len(self.cards):
            del self.cards[self.sel_global_idx]
            self.sel_global_idx=None; self._render_all_previews()

    # ------------- Export -------------
    def _page_image_export(self, idx):
        return self._page_image(idx, export=True)

    def _export_pdf(self):
        if not self.cards:
            messagebox.showwarning("No cards","Add at least one card."); return
        path = filedialog.asksaveasfilename(
            defaultextension=".pdf",
            filetypes=[("PDF","*.pdf")],
            initialfile="menu_cards.pdf",
            title="Save PDF as…",
        )
        if not path: return
        try:
            pages=[]
            total_pages = max(1, math.ceil(len(self.cards)/SLOTS_PER_PAGE))
            for p in range(total_pages):
                pages.append(self._page_image_export(p))
            first, rest = pages[0], pages[1:]
            first.save(path, "PDF", resolution=float(EXPORT_DPI), save_all=True, append_images=rest)
            messagebox.showinfo("Saved", f"Exported:\n{path}")
        except Exception as e:
            messagebox.showerror("Export failed", str(e))

