# --------- Caches for speed ----------
_font_cache = {}
_icon_cache = {}
_grad_cache = {}

def load_font(path, pt):
    key = (path, int(pt))
    if key in _font_cache: return _font_cache[key]
    try:
        f = ImageFont.truetype(path, int(round(pt)))
    except Exception:
        # system fallbacks
        fallbacks = [
            "/System/Library/Fonts/Supplemental/Arial.ttf",
            "C:/Windows/Fonts/arial.ttf",
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        ]
        for fb in fallbacks:
            try: f = ImageFont.truetype(fb, int(round(pt))); break
            except: f = ImageFont.load_default()
    _font_cache[key] = f
    return f

def load_icon(path, size):
    key = (path, size)
    if key in _icon_cache: return _icon_cache[key]
    if not os.path.isfile(path): return None
    img = Image.open(path).convert("RGBA").resize((size,size), Image.LANCZOS)
    _icon_cache[key] = img
    return img

def make_shadow(size, blur=40, offset=(25,25), alpha=120, shape="ellipse", radius=18):
    w,h = size
    pad = blur*2+max(offset)
    img = Image.new("RGBA", (w+pad, h+pad), (0,0,0,0))
    sh = Image.new("L", (w, h), 0)
    d = ImageDraw.Draw(sh)
    if shape == "ellipse":
        d.ellipse([0,0,w-1,h-1], fill=alpha)
    else: # rounded rect
        d.rounded_rectangle([0,0,w-1,h-1], radius=radius, fill=alpha)
    sh = sh.filter(ImageFilter.GaussianBlur(blur))
    img.paste(Image.new("RGBA", sh.size, (0,0,0,255)), (offset[0], offset[1]), sh)
    return img

def circle_button_image(diameter, fill_hex, outline_hex, stroke=BTN_STROKE,
                        icon_path=None, pressed=False):
    # base canvas
    sh = make_shadow((diameter, diameter), **SHADOW)
    w,h = sh.size
    img = Image.new("RGBA", (w,h), (0,0,0,0))
    if pressed:
        # reduce shadow by blending with transparency & nudge
        sh = sh.copy()
        sh.putalpha(int(0.6*SHADOW["alpha"]))
        img.alpha_composite(sh, (0,0))
        nudge = PRESSED_NUDGE
    else:
        img.alpha_composite(sh, (0,0))
        nudge = (0,0)

    d = ImageDraw.Draw(img)
    x = SHADOW["offset"][0]//2 + SHADOW["blur"] - nudge[0]
    y = SHADOW["offset"][1]//2 + SHADOW["blur"] - nudge[1]
    bbox = [x,y,x+diameter-1,y+diameter-1]
    d.ellipse(bbox, fill=HEX(fill_hex), outline=HEX(outline_hex), width=stroke)

    if icon_path and os.path.isfile(icon_path):
        icon_sz = int(diameter*0.62)
        ic = load_icon(icon_path, icon_sz)
        if ic:
            # center
            ix = x + (diameter - icon_sz)//2
            iy = y + (diameter - icon_sz)//2
            img.alpha_composite(ic, (ix, iy))
    return img

def pill_button_image(width, height, fill_hex, outline_hex, label, label_color="#443b3b",
                      left_glyph=None, pressed=False):
    sh = make_shadow((width, height), **SHADOW, shape="roundrect", radius=int(height*0.5))
    w,h = sh.size
    img = Image.new("RGBA", (w,h), (0,0,0,0))
    if pressed:
        sh.putalpha(int(0.6*SHADOW["alpha"]))
        img.alpha_composite(sh, (0,0))
        nudge = PRESSED_NUDGE
    else:
        img.alpha_composite(sh, (0,0))
        nudge = (0,0)
    d = ImageDraw.Draw(img)
    x = SHADOW["offset"][0]//2 + SHADOW["blur"] - nudge[0]
    y = SHADOW["offset"][1]//2 + SHADOW["blur"] - nudge[1]
    bbox = [x,y,x+width-1,y+height-1]
    d.rounded_rectangle(bbox, radius=height//2, fill=HEX(fill_hex), outline=HEX(outline_hex), width=BTN_STROKE)

    # left glyph (small circle with +) if provided
    if left_glyph == "plus":
        cx = x + int(height*0.35)
        cy = y + height//2
        r  = int(height*0.28)
        d.ellipse([cx-r, cy-r, cx+r, cy+r], outline=HEX("#6b6b6b"), width=2, fill=None)
        # plus sign
        d.line([cx-r+4,cy, cx+r-4,cy], fill=HEX("#6b6b6b"), width=2)
        d.line([cx,cy-r+4, cx,cy+r-4], fill=HEX("#6b6b6b"), width=2)

    # label
    font = load_font(FONT_KIEVIT, int(height*0.42))
    tw = d.textbbox((0,0), label, font=font)[2]
    text_x = x + int(height*0.7)
    if tw > width - (height*0.9):
        # shrink if needed
        scale = (width - (height*0.9)) / max(1, tw)
        font = load_font(FONT_KIEVIT, max(10, int(height*0.42*scale)))
    d.text((text_x, y + height*0.25), label, font=font, fill=HEX(label_color))
    return img

def preview_gradient(w, h):
    key = (w,h)
    if key in _grad_cache: return _grad_cache[key]
    # Make a small diagonal gradient then upscale (fast)
    base = 256
    g = Image.new("RGB", (base, base))
    p = g.load()
    c0, c1, c2 = map(HEX, PREVIEW_PAGE_GRAD)
    for y in range(base):
        for x in range(base):
            t = (x + y) / (2*base-2)
            if t < 0.5:
                u = t*2
                rgb = (
                    int(c0[0] + u*(c1[0]-c0[0])),
                    int(c0[1] + u*(c1[1]-c0[1])),
                    int(c0[2] + u*(c1[2]-c0[2])),
                )
            else:
                u = (t-0.5)*2
                rgb = (
                    int(c1[0] + u*(c2[0]-c1[0])),
                    int(c1[1] + u*(c2[1]-c1[1])),
                    int(c1[2] + u*(c2[2]-c1[2])),
                )
            p[x,y] = rgb
    g = g.resize((w,h), Image.LANCZOS)
    _grad_cache[key] = g
    return g

# --------- Data model ----------
class MenuCard:
    def __init__(self, title, allergens, cc_all=False, attributes=None,
                 artificial_colors=None, textures=None):
        self.title = title.strip()
        self.allergens = [a for a in TOP9 if a in allergens]
        self.cc_all = bool(cc_all)
        self.attributes = set(attributes or set())
        self.artificial_colors = list(artificial_colors or [])
        self.textures = list(textures or [])

    @property
    def allergens_line(self):
        if self.cc_all:
            return "CC: May Contain All Allergens"
        if not self.allergens:
            return ""  # per spec: omit if none
        return "Allergens: " + ", ".join(self.allergens)

    @property
    def contains_line(self):
        bits = []
        if self.artificial_colors: bits.extend(self.artificial_colors)
        if self.textures: bits.extend(self.textures)
        return ("Contains: " + ", ".join(bits)) if bits else ""

